# Sunset workspace environment
# Copy this file to `.env.local` and fill values for your target Conflux eSpace environment.

# Shared Conflux RPC
CONFLUX_RPC_URL=https://evm.confluxrpc.com
RPC_URL=${CONFLUX_RPC_URL}

# Frontend runtime
VITE_RPC_URL=${CONFLUX_RPC_URL}
VITE_ASP_URL=http://localhost:3001
VITE_CHAIN_ID=0x406
VITE_CHAIN_NAME=Conflux eSpace
VITE_EXPLORER_URL=https://evm.confluxscan.org
VITE_POOL_ADDRESS=
VITE_COORDINATOR_ADDRESS=
VITE_RELAYER_ADDRESS=

# ASP runtime
ASP_HOST=127.0.0.1
ASP_PORT=3001
DATABASE_PATH=./sunset_asp.db
WORKER_PATH=./asp/worker/worker.mjs
DEPLOYED_ADDRESSES_PATH=./contracts/solidity/deployments/contracts.json
COORDINATOR_ADDRESS=
POOL_ADDRESS=
ADMIN_ADDRESS=
ADMIN_PRIVATE_KEY=
RELAYER_ENABLED=false
EVENT_SYNC_ENABLED=false
SYNC_POLL_INTERVAL_SECS=10
